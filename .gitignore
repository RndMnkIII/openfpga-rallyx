# Local-only: reference checkouts and packaged SD output
.repos/
release/
.roms/
.ignore/

# Quartus build databases and outputs (regenerated on compile)
db/
incremental_db/
output_files/
greybox_tmp/
hc_output/
simulation/
.qsys_edit/

# Generated IP simulation models
*_sim/
*_sim.f

# Generated build ID (pre-flow script recreates these each build)
build_id.v
build_id.mif

# Generated IP metadata (the .qip/.sip/.v sources are kept)
*.bsf
*.ppf
*.spd

# Quartus reports / temp / programming artifacts
*.rpt
*.summary
*.smsg
*.done
*.jdi
*.pin
*.qws
*.qdf
*.sof
*.rbf
*.rbf_r
PLLJ_PLLSPE_INFO.txt
c5_pin_model_dump.txt

# Python bytecode (tools/)
__pycache__/
*.py[cod]

# Editor / patch junk
*.bak
*.orig
*.rej
*~

# Release archives (built by tools/package.py --zip)
*.zip

# Assembled ROM blobs (copyrighted - never commit)
build/
*.rom
